{
  "name": "LEOPARD VENT (irregular-cell vent / lightening pattern)",
  "scad": "src/leopard_vent.scad",
  "outdir": "exports",
  "previewdir": "previews",
  "_notes": [
    "Panel cases expect exactly one body: the holes are disjoint, so the webs",
    "between them always join up through the border.",
    "Cutter cases expect one body per hole, matching the hole count ribcheck",
    "measures on the panel with the same settings -- the two outputs cut the",
    "same holes. cutter_default and cutter_pocket pair with default,",
    "cutter_crop with crop_quads.",
    "ribcheck blocks are read by tools/ribcheck.py, not by scadkit. Their rib",
    "and border are the EFFECTIVE values: border is raised to the rib, and",
    "min_hole is clamped to 0.8 of the nominal hole, as the .scad does.",
    "Edges default to Fit; the crop_* cases cover Crop. A circle is always",
    "cropped.",
    "No max_degenerate allowance anywhere: the part is extruded straight from",
    "2D, with no CGAL boolean to leave slivers, and none appear."
  ],
  "cases": [
    {"name": "default", "params": {}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "shape_3_sides", "params": {"cell_shape": "3 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "shape_6_sides", "params": {"cell_shape": "6 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "shape_unknown", "params": {"cell_shape": "5 sides"}, "expect": {"rejected": "unknown shape"}},
    {"name": "regular_grid", "params": {"irregularity": 0}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "regular_isogrid", "params": {"irregularity": 0, "cell_shape": "3 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "regular_honeycomb", "params": {"irregularity": 0, "cell_shape": "6 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "irregular_max_quads", "params": {"irregularity": 1}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "irregular_max_tris", "params": {"irregularity": 1, "cell_shape": "3 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "irregular_max_hexes", "params": {"irregularity": 1, "cell_shape": "6 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "seed_999", "params": {"seed": 999}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "crop_quads", "params": {"edges": "Crop"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "crop_tris", "params": {"edges": "Crop", "cell_shape": "3 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "crop_hexes", "params": {"edges": "Crop", "cell_shape": "6 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "crop_regular_honeycomb", "params": {"edges": "Crop", "cell_shape": "6 sides", "irregularity": 0}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "fit_thin_strip", "params": {"panel_width": 200, "panel_height": 30, "border": 4, "cell_size": 12, "cell_shape": "6 sides", "irregularity": 1}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [200.01, 30.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 4.0, "min_hole": 4.0, "min_holes": 12}},
    {"name": "fit_awkward_size", "params": {"panel_width": 97, "panel_height": 41, "border": 3, "cell_size": 9, "rib_thickness": 1.2, "cell_shape": "3 sides", "irregularity": 1}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [97.01, 41.01, 3.01]}, "ribcheck": {"rib": 1.2, "border": 3.0, "min_hole": 4.0}},
    {"name": "circle", "params": {"panel_shape": "Circle"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [120.01, 120.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "circle_max_hexes", "params": {"panel_shape": "Circle", "panel_width": 250, "cell_shape": "6 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [250.01, 250.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 200}},
    {"name": "panel_min", "params": {"panel_width": 30, "panel_height": 30, "border": 1}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [30.01, 30.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 2.0, "min_hole": 4.0, "min_holes": 1}},
    {"name": "panel_max_fine_tris", "params": {"panel_width": 250, "panel_height": 250, "cell_size": 5, "rib_thickness": 0.8, "irregularity": 1, "cell_shape": "3 sides"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [256, 256, 256]}, "ribcheck": {"rib": 0.8, "border": 5.0, "min_holes": 1500}},
    {"name": "panel_corner_clamped", "params": {"panel_width": 60, "panel_height": 40, "panel_corner_radius": 30}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [60.01, 40.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_holes": 1}},
    {"name": "panel_corner_sharp", "params": {"panel_corner_radius": 0}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_holes": 40}},
    {"name": "cell_min", "params": {"cell_size": 5, "rib_thickness": 0.8}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 0.8, "border": 5.0, "min_holes": 200}},
    {"name": "cell_max", "params": {"cell_size": 60}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 1}},
    {"name": "rib_min", "params": {"rib_thickness": 0.8}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 0.8, "border": 5.0, "min_hole": 4.0}},
    {"name": "rib_max", "params": {"rib_thickness": 10, "cell_size": 40}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 10.0, "border": 10.0, "min_hole": 4.0, "min_holes": 1}},
    {"name": "rib_leaves_no_hole", "params": {"rib_thickness": 9, "cell_size": 10}, "expect": {"rejected": "leaves holes only"}},
    {"name": "rib_unprintable", "params": {"rib_thickness": 0.5}, "expect": {"rejected": "will not print as a wall"}},
    {"name": "border_raised_to_rib", "params": {"border": 1, "rib_thickness": 3}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 3.0, "border": 3.0, "min_hole": 4.0}},
    {"name": "border_max", "params": {"border": 30}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 30.0, "min_hole": 4.0, "min_holes": 1}},
    {"name": "border_fills_panel", "params": {"panel_width": 30, "panel_height": 30, "border": 15}, "expect": {"rejected": "leaves only"}},
    {"name": "corner_radius_min", "params": {"hole_corner_radius": 0.5}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "corner_radius_clamped", "params": {"hole_corner_radius": 8}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 1}},
    {"name": "min_hole_off", "params": {"min_hole": 0}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0}},
    {"name": "min_hole_off_crop", "params": {"min_hole": 0, "edges": "Crop"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0}},
    {"name": "min_hole_clamped", "params": {"min_hole": 20}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [180, 180, 180]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 9.6, "min_holes": 1}},
    {"name": "thickness_min", "params": {"thickness": 1.0}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [120.01, 80.01, 1.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "thickness_max", "params": {"thickness": 12}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [120.01, 80.01, 12.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "pocket", "params": {"hole_type": "Pocket"}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [120.01, 80.01, 3.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0, "min_holes": 40}},
    {"name": "pocket_shallowest", "params": {"hole_type": "Pocket", "thickness": 1.0, "floor_thickness": 0.6}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [120.01, 80.01, 1.01]}, "ribcheck": {"rib": 2.0, "border": 5.0, "min_hole": 4.0}},
    {"name": "pocket_too_shallow", "params": {"hole_type": "Pocket", "thickness": 1.0, "floor_thickness": 0.8}, "expect": {"rejected": "deep -- thin the floor"}},
    {"name": "cutter_default", "params": {"output": "Cutter"}, "expect": {"watertight": true, "bodies": 40, "max_bbox": [110.01, 70.01, 5.01]}},
    {"name": "cutter_crop", "params": {"output": "Cutter", "edges": "Crop"}, "expect": {"watertight": true, "bodies": 48, "max_bbox": [110.01, 70.01, 5.01]}},
    {"name": "cutter_pocket", "params": {"output": "Cutter", "hole_type": "Pocket"}, "expect": {"watertight": true, "bodies": 40, "min_bbox": [0, 0, 2.99], "max_bbox": [110.01, 70.01, 3.01]}},
    {"name": "everything_max", "params": {"panel_width": 250, "panel_height": 250, "thickness": 12, "panel_corner_radius": 30, "border": 30, "cell_shape": "6 sides", "cell_size": 60, "rib_thickness": 10, "irregularity": 1, "hole_corner_radius": 8, "min_hole": 20, "seed": 999, "hole_type": "Pocket", "floor_thickness": 6}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [256, 256, 256]}, "ribcheck": {"rib": 10.0, "border": 30.0, "min_hole": 20.0, "min_holes": 1}},
    {"name": "everything_min", "params": {"panel_width": 30, "panel_height": 30, "thickness": 1.0, "panel_corner_radius": 0, "border": 1, "cell_shape": "4 sides", "cell_size": 5, "rib_thickness": 0.8, "irregularity": 0, "hole_corner_radius": 0.5, "min_hole": 0, "seed": 1}, "expect": {"watertight": true, "bodies": 1, "max_bbox": [30.01, 30.01, 1.01]}, "ribcheck": {"rib": 0.8, "border": 1.0, "min_holes": 25}}
  ],
  "views": [
    {"name": "top", "camera": "0,0,0,0,0,0,0"},
    {"name": "iso", "camera": "0,0,0,55,0,25,0"}
  ]
}
