# Validation meshes are regenerated by the matrix in a few minutes and are not
# worth 40MB of history. Only the three exports a user actually prints are kept.
projects/*/exports/*
!projects/*/exports/default_tile.stl
!projects/*/exports/fit_coupon.stl
!projects/*/exports/joining_keys.stl
!projects/*/exports/default.stl

*.stl.tmp
*.csg
*.deps
__pycache__/
*.pyc
.venv/
venv/

# OpenSCAD editor/session cruft
*.scad.bak
.OpenSCAD/

# OS cruft
.DS_Store
Thumbs.db
